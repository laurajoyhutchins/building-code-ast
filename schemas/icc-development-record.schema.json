{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/building-code-ast/icc-development-record.schema.json",
  "title": "Building Code AST ICC Development Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "record_id",
    "type",
    "source_id",
    "proposal_id",
    "record_key",
    "kind",
    "disposition",
    "sequence",
    "proponent",
    "affected_locators",
    "parent_keys",
    "action_date",
    "summary",
    "source_page",
    "source_anchor"
  ],
  "properties": {
    "record_version": {"const": "0.1.0"},
    "record_id": {"type": "string", "pattern": "^development:[0-9a-f]{64}$"},
    "type": {"const": "development_record"},
    "source_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "pattern": "^[A-Z]+[0-9]+-[0-9]{2}$"},
    "record_key": {"type": "string", "minLength": 1},
    "kind": {
      "enum": [
        "proposal",
        "public_comment",
        "committee_action",
        "hearing_action",
        "final_action"
      ]
    },
    "disposition": {
      "enum": [
        "submitted",
        "approved",
        "approved_as_modified",
        "disapproved",
        "withdrawn",
        "superseded"
      ]
    },
    "sequence": {"type": "integer", "minimum": 1},
    "proponent": {"type": ["string", "null"], "minLength": 1},
    "affected_locators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "parent_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "action_date": {"type": ["string", "null"], "format": "date"},
    "summary": {"type": "string", "minLength": 1},
    "source_page": {"type": "integer", "minimum": 1},
    "source_anchor": {"type": "string", "minLength": 1}
  }
}
