{
  "$id": "source-object-catalog",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_version": {"const": "0.1.0"},
    "type": {"const": "source_object_catalog"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "object_key", "sha256", "size", "media_type"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "object_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1},
          "media_type": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "required": ["catalog_version", "type", "entries"],
  "type": "object"
}
