{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/building-code-ast/source-register.schema.json",
  "title": "Building Code AST Source Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["register_version", "type", "entries"],
  "properties": {
    "register_version": {"const": "0.1.0"},
    "type": {"const": "source_register"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceRegisterEntry"}
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "optionalString": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "astSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "edition_id"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/nonemptyString"},
        "edition_id": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "publicationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "publication_family",
        "edition",
        "printing",
        "digital_revision",
        "correction_set",
        "published_on",
        "effective_on"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "pattern": "^publication:[0-9a-f]{64}$"
        },
        "publication_family": {"$ref": "#/$defs/nonemptyString"},
        "edition": {"$ref": "#/$defs/nonemptyString"},
        "printing": {"$ref": "#/$defs/optionalString"},
        "digital_revision": {"$ref": "#/$defs/optionalString"},
        "addenda_set": {"$ref": "#/$defs/nonemptyString"},
        "correction_set": {"$ref": "#/$defs/optionalString"},
        "published_on": {
          "type": ["string", "null"],
          "format": "date"
        },
        "effective_on": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "sourceRegisterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "ast_source",
        "title",
        "issuing_body",
        "evidence_role",
        "publication",
        "retrieved_at",
        "sha256",
        "media_type",
        "access_scope",
        "rights_status",
        "source_url",
        "jurisdiction",
        "rights_note"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/nonemptyString"},
        "ast_source": {"$ref": "#/$defs/astSourceIdentity"},
        "title": {"$ref": "#/$defs/nonemptyString"},
        "issuing_body": {"$ref": "#/$defs/nonemptyString"},
        "evidence_role": {
          "enum": [
            "normative_text",
            "official_correction",
            "development_history",
            "jurisdictional_law",
            "administrative_guidance",
            "official_interpretation",
            "commentary",
            "secondary_analysis"
          ]
        },
        "publication": {"$ref": "#/$defs/publicationIdentity"},
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {"$ref": "#/$defs/nonemptyString"},
        "access_scope": {
          "enum": ["public", "authenticated", "licensed_local", "private_local"]
        },
        "rights_status": {
          "enum": [
            "public_official",
            "public_domain",
            "licensed",
            "project_authored",
            "uncertain_restricted"
          ]
        },
        "source_url": {"$ref": "#/$defs/optionalString"},
        "jurisdiction": {"$ref": "#/$defs/optionalString"},
        "rights_note": {"$ref": "#/$defs/optionalString"}
      }
    }
  }
}
