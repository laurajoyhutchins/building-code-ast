{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/building-code-ast/icc-errata-record.schema.json",
  "title": "Building Code AST ICC Erratum Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "record_id",
    "type",
    "source_id",
    "sequence",
    "base_publication_state_id",
    "correction_set",
    "applies_to_printings",
    "target_kind",
    "target_locator",
    "target_page_label",
    "operation",
    "instruction",
    "replacement_text",
    "source_page",
    "source_anchor"
  ],
  "properties": {
    "record_version": {"const": "0.1.0"},
    "record_id": {"type": "string", "pattern": "^erratum:[0-9a-f]{64}$"},
    "type": {"const": "erratum_record"},
    "source_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "base_publication_state_id": {
      "type": "string",
      "pattern": "^publication:[0-9a-f]{64}$"
    },
    "correction_set": {"type": "string", "minLength": 1},
    "applies_to_printings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_kind": {
      "enum": [
        "section",
        "table",
        "figure",
        "definition",
        "referenced_standard",
        "other"
      ]
    },
    "target_locator": {"type": "string", "minLength": 1},
    "target_page_label": {"type": "string", "minLength": 1},
    "operation": {"enum": ["insert", "replace", "delete"]},
    "instruction": {"type": "string", "minLength": 1},
    "replacement_text": {"type": ["string", "null"], "minLength": 1},
    "source_page": {"type": "integer", "minimum": 1},
    "source_anchor": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "delete"}}},
      "then": {"properties": {"replacement_text": {"type": "null"}}},
      "else": {"properties": {"replacement_text": {"type": "string", "minLength": 1}}}
    }
  ]
}
