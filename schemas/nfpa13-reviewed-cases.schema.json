{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laurajoyhutchins/building-code-ast/schemas/nfpa13-reviewed-cases.schema.json",
  "title": "NFPA 13 reviewed non-source-bearing cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_pdf_sha256", "reviewed_at", "cases"],
  "properties": {
    "schema": {"const": "nfpa13-reviewed-cases/0.1.0"},
    "source_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_at": {"type": "string", "format": "date"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "locator", "assertion", "expected", "basis"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "assertion": {"type": "string", "minLength": 1},
          "expected": {},
          "basis": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
