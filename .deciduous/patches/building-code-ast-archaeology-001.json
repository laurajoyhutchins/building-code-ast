\",\"pr\":1,\"repo\":\"laurajoyhutchins/building-code-ast\",\"state\":\"merged\"},{\"kind\":\"path\",\"path\":\"docs/architecture.md\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"}],\"lifecycle_status\":\"active\",\"repository_owner\":\"laurajoyhutchins/building-code-ast\",\"semantic_id\":\"decision.compiler-not-search\",\"source_state\":\"accepted\",\"support_scope\":\"current architecture\",\"tags\":[]}","node_type":"decision","status":"active","title":"Build a staged compiler rather than a search index"},{"change_id":"50c60ffd-a638-59a0-b86e-c5995e590f0d","description":"The project owns deterministic source structure and parser evidence. Retrieval, jurisdiction selection, and compliance conclusions remain downstream concerns.","metadata_json":"{\"arc\":\"concept\",\"confidence\":\"high\",\"current_architecture\":true,\"date\":\"2026-07-23\",\"evidence\":[{\"kind\":\"path\",\"path\":\"README.md\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"},{\"kind\":\"path\",\"path\":\"docs/architecture.md\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"}],\"lifecycle_status\":\"active\",\"repository_owner\":\"laurajoyhutchins/building-code-ast\",\"semantic_id\":\"outcome.source-structure-layer\",\"source_state\":\"accepted\",\"support_scope\":\"current architecture\",\"tags\":[]}","node_type":"outcome","status":"active","title":"Building Code AST became a source-structure and evidence layer"},{"change_id":"debf2b9e-b113-504e-81c7-e8a30554a026","description":"An AST can identify and transform an edition, but it does not make the derived structure authoritative, establish adoption, or replace official text and AHJ judgment.","metadata_json":"{\"arc\":\"concept\",\"confidence\":\"high\",\"current_architecture\":true,\"date\":\"2026-07-23\",\"evidence\":[{\"commit\":\"6a4be1604ef8a85ffea4144e2dff571253fcb39d\",\"kind\":\"pull_request\",\"pr\":1,\"repo\":\"laurajoyhutchins/building-code-ast\",\"state\":\"merged\"},{\"commit\":\"b44c16ebe837132c894a9c62000065ee2337cd15\",\"kind\":\"pull_request\",\"pr\":7,\"repo\":\"laurajoyhutchins/building-code-ast\",\"state\":\"merged\"},{\"kind\":\"path\",\"path\":\"docs/legal-safety-boundary.md\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"},{\"kind\":\"path\",\"path\":\"docs/corpus-policy.md\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"}],\"lifecycle_status\":\"active\",\"repository_owner\":\"laurajoyhutchins/building-code-ast\",\"semantic_id\":\"decision.no-legal-authority-claim\",\"source_state\":\"accepted\",\"support_scope\":\"governance boundary\",\"tags\":[]}","node_type":"decision","status":"active","title":"Separate technical representation from legal authority"},{"change_id":"b237eb1b-afb7-5d5b-a61c-f1c43fcb0936","description":"The initial provision parser proved exact semantic spans were possible, but it could not express chapters, nested lists, definitions, tables, or document-level hierarchy.","metadata_json":"{\"arc\":\"schema\",\"confidence\":\"high\",\"current_architecture\":true,\"date\":\"2026-07-26\",\"evidence\":[{\"commit\":\"6a4be1604ef8a85ffea4144e2dff571253fcb39d\",\"kind\":\"pull_request\",\"pr\":1,\"repo\":\"laurajoyhutchins/building-code-ast\",\"state\":\"merged\"},{\"commit\":\"d73b20bfa6c9bf216ceb09a1b557ce2c5bf552dd\",\"kind\":\"pull_request\",\"pr\":8,\"repo\":\"laurajoyhutchins/building-code-ast\",\"state\":\"merged\"}],\"lifecycle_status\":\"active\",\"repository_owner\":\"laurajoyhutchins/building-code-ast\",\"semantic_id\":\"goal.structure-before-semantics\",\"source_state\":\"accepted\",\"support_scope\":\"current architecture\",\"tags\":[]}","node_type":"goal","status":"active","title":"Represent publication structure before interpreting rule meaning"},{"change_id":"ba63e929-d69a-5115-8677-be2987eb20bb","description":"Modality, threshold, action, and exception fields were useful for a bounded sentence, yet document ingestion required a separate tree that did not prematurely assign semantics.","metadata_json":"{\"arc\":\"schema\",\"confidence\":\"high\",\"current_architecture\":false,\"date\":\"2026-07-26\",\"evidence\":[{\"commit\":\"6a4be1604ef8a85ffea4144e2dff571253fcb39d\",\"kind\":\"pull_request\",\"pr\":1,\"repo\":\"laurajoyhutchins/building-code-ast\",\"state\":\"merged\"},{\"commit\":\"d73b20bfa6c9bf216ceb09a1b557ce2c5bf552dd\",\"kind\":\"pull_request\",\"pr\":8,\"repo\":\"laurajoyhutchins/building-code-ast\",\"state\":\"merged\"},{\"kind\":\"path\",\"path\":\"src/building_code_ast/model.py\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"},{\"kind\":\"path\",\"path\":\"src/building_code_ast/document_model.py\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"}],\"lifecycle_status\":\"completed\",\"repository_owner\":\"laurajoyhutchins/building-code-ast\",\"semantic_id\":\"obs.provision-slice-too-narrow\",\"source_state\":\"accepted\",\"support_scope\":\"historical\",\"tags\":[]}","node_type":"observation","status":"completed","title":"A provision-first AST could not carry full document organization"},{"change_id":"c289b73c-0587-5a46-bc61-06764fb4859e","description":"This would make every structural parser imply semantic correctness and force code-family layout facts into a meaning-oriented schema.","metadata_json":"{\"arc\":\"schema\",\"confidence\":\"high\",\"current_architecture\":false,\"date\":\"2026-07-26\",\"evidence\":[{\"commit\":\"d73b20bfa6c9bf216ceb09a1b557ce2c5bf552dd\",\"kind\":\"pull_request\",\"pr\":8,\"repo\":\"laurajoyhutchins/building-code-ast\",\"state\":\"merged\"},{\"kind\":\"path\",\"path\":\"docs/reference/document-ast.md\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"}],\"lifecycle_status\":\"rejected\",\"repository_owner\":\"laurajoyhutchins/building-code-ast\",\"semantic_id\":\"option.single-semantic-tree\",\"source_state\":\"rejected\",\"support_scope\":\"historical\",\"tags\":[]}","node_type":"option","status":"rejected","title":"Put publication hierarchy and interpreted rule meaning in one universal tree"},{"change_id":"c2a3d5b7-df28-5611-8f88-81bb0c0d2adc","description":"The Document AST records source artifact, edition, recursive structural nodes, stable identities, exact spans, and diagnostics while excluding modality, conditions, actions, and compliance fields.","metadata_json":"{\"arc\":\"schema\",\"confidence\":\"high\",\"current_architecture\":true,\"date\":\"2026-07-26\",\"evidence\":[{\"commit\":\"d73b20bfa6c9bf216ceb09a1b557ce2c5bf552dd\",\"kind\":\"pull_request\",\"pr\":8,\"repo\":\"laurajoyhutchins/building-code-ast\",\"state\":\"merged\"},{\"kind\":\"path\",\"path\":\"src/building_code_ast/document_model.py\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"},{\"kind\":\"path\",\"path\":\"schemas/document-ast.schema.json\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"}],\"lifecycle_status\":\"active\",\"repository_owner\":\"laurajoyhutchins/building-code-ast\",\"semantic_id\":\"decision.document-ast-separate\",\"source_state\":\"accepted\",\"support_scope\":\"document-ast 0.1.0\",\"tags\":[]}","node_type":"decision","status":"active","title":"Create an independently versioned Document AST"},{"change_id":"499f4a70-1b5e-5b97-b392-97ed127a448f","description":"Stable identifiers survive reparsing of the same edition while changing when the publication identity changes; source text and offsets remain evidence rather than identity inputs.","metadata_json":"{\"arc\":\"schema\",\"confidence\":\"high\",\"current_architecture\":true,\"date\":\"2026-07-26\",\"evidence\":[{\"kind\":\"path\",\"path\":\"src/building_code_ast/document_model.py\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"},{\"kind\":\"path\",\"path\":\"docs/reference/document-ast.md\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"}],\"lifecycle_status\":\"active\",\"repository_owner\":\"laurajoyhutchins/building-code-ast\",\"semantic_id\":\"decision.stable-structural-identities\",\"source_state\":\"accepted\",\"support_scope\":\"document-ast 0.1.0\",\"tags\":[]}","node_type":"decision","status":"active","title":"Derive node identity from artifact, edition, node type, and structural locator"},{"change_id":"374f8740-1482-56c3-b1cf-90961b5a884f","description":"Document, chapter, section, subsection, paragraph, list item, definition entry, table parts, headings, notes, footnotes, and unsupported structures form the common vocabulary without claiming a common grammar.","metadata_json":"{\"arc\":\"schema\",\"confidence\":\"high\",\"current_architecture\":true,\"date\":\"2026-07-28\",\"evidence\":[{\"kind\":\"path\",\"path\":\"src/building_code_ast/document_model.py\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"},{\"kind\":\"path\",\"path\":\"schemas/document-ast.schema.json\",\"ref\":\"main\",\"repo\":\"laurajoyhutchins/building-code-ast\"}],\"lifecycle_status\":\"active\",\"repository_owner\":\"laurajoyhutchins/building-code-ast\",\"semantic_id\":\"outcome.shared-document-primitives\",\"source_state\":\"accepted\",\"support_scope\":\"document-ast 0.1.0\",\"tags\":[]}","node_type":"outcome","status":"active","title":"Shared document primitives became the neutral contract"}],"version":"1.0"}
